# ─────────────────────────────────────────────────────────────────────────────
# Jenkins Credentials Secret — example template
#
# Jenkins mounts this secret to provide pipeline credentials for Git (SSH key)
# and Docker Hub (username/password).  Credential IDs must match the values
# configured in config/defaults.yaml (jenkins_git_creds_id, etc.).
#
# Usage:
#   1. Base64-encode each value:  echo -n "VALUE" | base64
#   2. Encrypt with kubeseal and commit the SealedSecret.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: jenkins-credentials
  namespace: jenkins                # adjust to the namespace where Jenkins runs
type: Opaque
data:
  # SSH private key for Git checkouts (jenkins_git_creds_id in config/defaults.yaml)
  git-ssh-private-key: <BASE64_ENCODED_SSH_PRIVATE_KEY>

  # Docker Hub username and password/token (jenkins_docker_creds_id)
  docker-username: <BASE64_ENCODED_DOCKER_USERNAME>
  docker-password: <BASE64_ENCODED_DOCKER_PASSWORD_OR_TOKEN>

  # Optional: personal access token for Git HTTPS operations (jenkins_git_user_creds_id)
  git-username: <BASE64_ENCODED_GIT_USERNAME>
  git-token:    <BASE64_ENCODED_GIT_PAT>

  # Argo CD API token used by CD pipelines to trigger syncs (jenkins_argocd_creds_id)
  argocd-token: <BASE64_ENCODED_ARGOCD_API_TOKEN>
