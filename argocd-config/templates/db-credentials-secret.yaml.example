# ─────────────────────────────────────────────────────────────────────────────
# Database Credentials Secret — example template
#
# One secret per namespace (prod / dev / stage).  Applications read the
# username and password from environment variables injected by the Helm chart.
#
# Usage:
#   1. Base64-encode each value:  echo -n "VALUE" | base64
#   2. Encrypt with kubeseal and commit the SealedSecret.
#   3. Repeat for each target namespace.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: prod                   # change to dev or stage as needed
type: Opaque
data:
  # PostgreSQL (postgres_port default: 5432 — see config/defaults.yaml)
  postgres-username: <BASE64_ENCODED_POSTGRES_USERNAME>
  postgres-password: <BASE64_ENCODED_POSTGRES_PASSWORD>
  postgres-host:     <BASE64_ENCODED_POSTGRES_HOST>       # e.g. postgres.prod.svc.cluster.local
  postgres-port:     <BASE64_ENCODED_POSTGRES_PORT>       # e.g. NTQzMg== (5432)
  postgres-db:       <BASE64_ENCODED_POSTGRES_DB_NAME>

  # MariaDB/MySQL (mysql_port default: 3306 — see config/defaults.yaml)
  mysql-username: <BASE64_ENCODED_MYSQL_USERNAME>
  mysql-password: <BASE64_ENCODED_MYSQL_PASSWORD>
  mysql-host:     <BASE64_ENCODED_MYSQL_HOST>             # e.g. mariadb.prod.svc.cluster.local
  mysql-port:     <BASE64_ENCODED_MYSQL_PORT>             # e.g. MzMwNg== (3306)
  mysql-db:       <BASE64_ENCODED_MYSQL_DB_NAME>
