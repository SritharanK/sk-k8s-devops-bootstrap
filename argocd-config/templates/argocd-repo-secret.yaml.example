# ─────────────────────────────────────────────────────────────────────────────
# Argo CD Git Repository SSH Secret — example template
#
# Argo CD reads this secret to pull manifests from your private Git repo.
# The SSH private key must correspond to a Deploy Key on the repository
# with read access.
#
# Generate a dedicated deploy key (no passphrase):
#   ssh-keygen -t ed25519 -C "argocd@<cluster_name>" -f argocd_deploy_key
#   # Add argocd_deploy_key.pub as a Deploy Key in GitHub/GitLab.
#   # Base64-encode the private key:
#   base64 -w 0 argocd_deploy_key
#
# Usage:
#   1. Fill in the base64 private key below.
#   2. Encrypt with kubeseal and commit the SealedSecret.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: argocd-repo-creds
  namespace: argocd                 # must match namespace_argocd in config/defaults.yaml
  labels:
    argocd.argoproj.io/secret-type: repository
type: Opaque
stringData:
  type: git
  url: git@github.com:<YOUR_ORG>/<YOUR_REPO>.git   # must match git_repo_ssh in config/defaults.yaml
  sshPrivateKey: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    <BASE64_OR_PEM_ENCODED_PRIVATE_KEY>
    -----END OPENSSH PRIVATE KEY-----
