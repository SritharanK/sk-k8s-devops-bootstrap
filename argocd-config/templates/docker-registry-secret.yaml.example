# ─────────────────────────────────────────────────────────────────────────────
# Docker Registry Image Pull Secret — example template
#
# Usage:
#   1. Replace all <PLACEHOLDER> values below.
#   2. Encrypt with kubeseal:
#        kubeseal --controller-name sealed-secrets \
#                 --controller-namespace kube-system \
#                 --format yaml < docker-registry-secret.yaml \
#                 > docker-registry-sealedsecret.yaml
#   3. Commit docker-registry-sealedsecret.yaml to Git.
#      DO NOT commit the unencrypted version.
#
# The .dockerconfigjson value is produced by:
#   kubectl create secret docker-registry regcred \
#     --docker-server=<REGISTRY_HOST> \
#     --docker-username=<REGISTRY_USER> \
#     --docker-password=<REGISTRY_PASSWORD> \
#     --dry-run=client -o yaml | grep .dockerconfigjson
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: docker-registry-secret     # must match docker_registry_secret_name in config/defaults.yaml
  namespace: prod                   # repeat per namespace (prod / dev / stage)
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: <BASE64_ENCODED_DOCKER_CONFIG_JSON>
