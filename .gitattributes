# Line endings: every text file is stored and checked out with LF on every
# platform. Shell scripts, Makefiles and YAML break or produce noisy diffs
# with CRLF.
* text=auto eol=lf

# Binary files: no line-ending conversion and no textual diff.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.gz    binary
*.tgz   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary

# Generated files: collapsed in pull request diffs and excluded from language
# statistics. Regenerate them, do not edit them by hand.
docs/reference/support-matrix.md        linguist-generated=true
**/Chart.lock                           linguist-generated=true
**/go.sum                               linguist-generated=true
# helm-docs output from README.md.gotmpl in the same directory.
helmcharts/app-charts/hello-api/README.md linguist-generated=true
# Prometheus rules generated by Sloth from slos/ (generate.sh).
helmcharts/system-charts/slo/rules/**     linguist-generated=true

# Third-party content kept verbatim: excluded from language statistics.
# Upstream charts copied unchanged under vendor/<chart>/, with the upstream
# licence; the README in vendor/ describes the source and checksum.
helmcharts/**/vendor/*/**                 linguist-vendored=true
helmcharts/**/vendor/LICENSE              linguist-vendored=true
# Unmodified upstream release manifests (CRDs and reference copies).
helmcharts/**/upstream/*.yaml             linguist-vendored=true
# Public signing key of the argo-helm releases, used to verify the provenance
# of the Argo CD chart (hack/argocd-install.sh).
helmcharts/system-charts/argo-cd/keys/argo-helm.asc linguist-vendored=true
