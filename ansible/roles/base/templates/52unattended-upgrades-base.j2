{{ ansible_managed | comment('c') }}
// Read after the distribution file 50unattended-upgrades. "#clear" empties the lists defined there (and by any
// other file read earlier), so only the security origins below are upgraded automatically.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
#clear Unattended-Upgrade::Package-Blacklist;

Unattended-Upgrade::Origins-Pattern {
{% if ansible_facts['distribution'] == 'Ubuntu' %}
        "origin=Ubuntu,archive=${distro_codename}-security";
        // Extended Security Maintenance; only present when the host is attached to Ubuntu Pro.
        "origin=UbuntuESMApps,archive=${distro_codename}-apps-security";
        "origin=UbuntuESM,archive=${distro_codename}-infra-security";
{% else %}
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
{% endif %}
};

// Python regular expressions matched against the start of the package name (from base_unattended_upgrades_exclude).
Unattended-Upgrade::Package-Blacklist {
{% for pattern in base_unattended_upgrades_exclude %}
        "{{ pattern | replace('.', '[.]') | replace('+', '[+]') | replace('*', '.*') | replace('?', '.') }}$";
{% endfor %}
};

Unattended-Upgrade::Automatic-Reboot "{{ 'true' if base_automatic_reboot else 'false' }}";
