# RKE2 node configuration — generated by Ansible.
# Full reference: https://docs.rke2.io/reference/server_config
---
{% if rke2_install_type == 'server' %}
# Control-plane / server node configuration
token: {{ rke2_token }}

# TLS SANs — add the load-balancer or public IP/DNS if applicable.
tls-san:
  - {{ ansible_default_ipv4.address }}
{% if rke2_tls_san_extra is defined and rke2_tls_san_extra | length > 0 %}
{% for san in rke2_tls_san_extra %}
  - {{ san }}
{% endfor %}
{% endif %}

# Container network interface (default: canal; options: calico, cilium, flannel)
cni: {{ rke2_cni | default('canal') }}

# Disable components that are replaced by this bootstrap's toolchain.
# nginx-ingress: replaced by argocd-managed ingress-nginx chart.
disable:
  - rke2-ingress-nginx

{% else %}
# Agent / worker node configuration
server: {{ rke2_server_url }}
token: {{ rke2_token }}
{% endif %}
