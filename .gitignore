# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

.vscode
.vscode/**/*
.vscode/*
mysql.yaml

# Ansible – do not commit vault password or cluster state
ansible/.ansible_vault_pass
ansible/data/kube_config_cluster.yaml
ansible/data/k8s_cluster.rkestate
ansible/data/*.rkestate
ansible/data/*.yaml
ansible/kube_config_cluster.yaml

# Local config and secrets – do not commit real values
config/defaults.yaml
scripts/misc/.env

# Local development env files – copy from .env.example, never commit real values
**/.env

# Helm dependency build artifacts – resolved locally via helm dependency build
# chart archives and Chart.lock are regenerated; only Chart.yaml is committed
helmcharts/**/charts/
helmcharts/**/Chart.lock

# SBOM artifacts – generated by syft in Jenkins CI and archived as build artefacts
# Occasional local runs should not pollute the working tree
*.cdx.json
*.spdx.json

# Internal planning and analysis documents – local only
docs/ANALYSIS.md
docs/UPGRADE_PLAN.md