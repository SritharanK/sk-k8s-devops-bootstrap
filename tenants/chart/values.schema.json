{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tenant chart values",
  "description": "Validated by Helm on every render, including in Argo CD, after merging values.yaml, the tenant file and the ApplicationSet valuesObject. The tenant keys mirror tenants/schema.json (the contract, checked in CI); keep both in step. Draft-07 so that older Helm 3 releases can read it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "groups", "environments", "sourceRepos", "quota", "limitRange", "namespaces", "cluster", "components"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "description": {"type": "string", "maxLength": 255},
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admins", "viewers"],
      "properties": {
        "admins": {"$ref": "#/definitions/groupName"},
        "viewers": {"$ref": "#/definitions/groupName"}
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["dev", "stage", "prod"]}
    },
    "sourceRepos": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(https://[^\\s*]+|ssh://[^\\s*]+|git@[^\\s:*]+:[^\\s*]+)$"
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests.cpu": {"$ref": "#/definitions/cpu"},
        "requests.memory": {"$ref": "#/definitions/bytes"},
        "limits.cpu": {"$ref": "#/definitions/cpu"},
        "limits.memory": {"$ref": "#/definitions/bytes"},
        "requests.storage": {"$ref": "#/definitions/bytes"},
        "pods": {"$ref": "#/definitions/count"},
        "persistentvolumeclaims": {"$ref": "#/definitions/count"},
        "services.loadbalancers": {"$ref": "#/definitions/count"},
        "services.nodeports": {"$ref": "#/definitions/count"}
      }
    },
    "limitRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "defaultRequest"],
      "properties": {
        "default": {"$ref": "#/definitions/cpuMemory"},
        "defaultRequest": {"$ref": "#/definitions/cpuMemory"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowEgressCidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/ipv4Cidr"}
        }
      }
    },
    "namespaces": {
      "description": "Platform-owned. Set by the ApplicationSet valuesObject.",
      "type": "object",
      "additionalProperties": false,
      "required": ["argocd", "gateway"],
      "properties": {
        "argocd": {"$ref": "#/definitions/dnsLabel"},
        "gateway": {"$ref": "#/definitions/dnsLabel"}
      }
    },
    "cluster": {
      "description": "Platform-owned. Set by the ApplicationSet valuesObject.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kubernetesMinor", "destination"],
      "properties": {
        "name": {"$ref": "#/definitions/dnsLabel"},
        "kubernetesMinor": {"type": "string", "pattern": "^1\\.[0-9]{2}$"},
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"$ref": "#/definitions/dnsLabel"}
          }
        }
      }
    },
    "components": {
      "description": "Platform-owned. Set by the ApplicationSet valuesObject.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaces", "project"],
      "properties": {
        "namespaces": {"type": "boolean"},
        "project": {"type": "boolean"}
      }
    },
    "global": {
      "description": "Reserved by Helm. Not read by this chart.",
      "type": "object"
    }
  },
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "groupName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s]+$"
    },
    "cpu": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]{1,3})?|[0-9]+m)$"
    },
    "bytes": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$"
    },
    "count": {
      "type": ["integer", "string"],
      "minimum": 0,
      "pattern": "^[0-9]+$"
    },
    "cpuMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"$ref": "#/definitions/cpu"},
        "memory": {"$ref": "#/definitions/bytes"}
      }
    },
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])/([0-9]|[12][0-9]|3[0-2])$"
    }
  }
}
