#cloud-config
# First-boot bootstrap only: one admin user for Ansible. Packages, sshd
# settings, the host firewall and RKE2 are managed by the Ansible roles.
users:
  - name: ${admin_username}
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${jsonencode(ssh_public_key)}
disable_root: true
ssh_pwauth: false
package_update: false
